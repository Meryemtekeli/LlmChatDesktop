<Window x:Class="LlmChatDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM ChatBot" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <!-- Mesajları Gösterme Alanı -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="6">
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ConversationPanel" />
            </ScrollViewer>
        </Border>
        <!-- Kullanıcı Girişi ve Buton -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,0">
            <TextBox x:Name="InputBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" FontSize="14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="SendBtn" Content="Gönder" Width="100" Click="SendBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
    